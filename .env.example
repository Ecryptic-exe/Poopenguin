# 必填：Discord Bot Token。只存放於本機 .env，勿傳到聊天或提交版本庫。
# 啟動：uv run --no-sync python -X utf8 launcher.py --env-file .env
TOKEN=

# 選填：留白沿用 bot.ini；修改後重新啟動。值為 literal，不展開 ${...}。
BOT_PREFIX=
# 只有明確填入才啟用選配模組，例如 chuni_penguin.cogs.chunithm.kamaitachi。
# 完整清單見 README.md；自動回應、管理、追蹤發訊與 AI 預設關閉。
BOT_COGS_EXTRA=
BOT_COGS_DISABLED=

# 選填：Kamaitachi 原有登入整合；還需在 BOT_COGS_EXTRA 明確啟用該模組。
KAMAITACHI_CLIENT_ID=
KAMAITACHI_CLIENT_SECRET=
KAMAITACHI_API_KEY=

# 選填：唯讀 Discord 驗證時檢查指定測試伺服器已註冊的指令。
# 不會自動邀請 Bot、更新遠端指令或發訊；無此值仍可驗證登入和 Gateway。
TEST_GUILD_ID=

# 選填：只供 penguin source-check 使用的「你本人」Chunirec Token。
# 不寫入玩家資料庫、不綁定 Discord 用戶。日常玩家綁定用 /account link 私人表單。
CHUNIREC_PLAYER_TOKEN=
CHUNIREC_REGION=jp2

# 選填：只有明確啟用 poopenguin.ai_cog 時才使用本機 LM Studio（舊 legacy_b 路徑仍相容）。
LM_STUDIO_BASE_URL=
LM_STUDIO_MODEL=
LM_STUDIO_VISION_MODEL=
